# Copy to .env and change every value before exposing this stack.
#   cp .env.example .env

# --- Database ---
MYSQL_DATABASE=beauty_alarm
MYSQL_USER=beauty_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Where MySQL keeps its files. Point this at NAS storage for a real deployment,
# e.g. /volume1/docker/beautyalarm/mysql
DB_DATA_PATH=./data/mysql

# --- Application ---
# IANA timezone. Every "today", due date and notification time resolves against
# this one zone (specs.md section 4).
APP_TIMEZONE=Europe/Madrid

# --- Accounts (D5a) ---
# Sign-in is per person now; there is no shared token. Create the first account
# on the sign-in screen, or with:
#   docker compose exec api python scripts/create_user.py

# How long a sign-in lasts on a device.
SESSION_TTL_DAYS=30

# Set the Secure flag on the session cookie. Leave false for plain-http
# localhost; set true for any real deployment, which is HTTPS via the tunnel.
COOKIE_SECURE=false

# Open registration (D14). Anyone who can reach the app can create an account
# while this is on. Turn it off once the household has signed up, and keep
# Cloudflare Access in front of the tunnel regardless.
ALLOW_REGISTRATION=true

# Sign-in and sign-up attempts allowed per client address per window.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300

# Port nginx is published on locally. Behind the tunnel this is not used.
WEB_PORT=8080

# --- Web Push (D1b) ---
# Generate a pair with:
#   docker compose exec api python scripts/generate_vapid_keys.py
# Without these, notifications are disabled and the scheduler does not start.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Cloudflare Tunnel ---
# From the Cloudflare Zero Trust dashboard. Start it with:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
