# Copy to .env and change every value before exposing this stack.
#   cp .env.example .env

# --- Database ---
MYSQL_DATABASE=beauty_alarm
MYSQL_USER=beauty_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Where MySQL keeps its files. Point this at NAS storage for a real deployment,
# e.g. /volume1/docker/beautyalarm/mysql
DB_DATA_PATH=./data/mysql

# --- Application ---
# IANA timezone. Every "today", due date and notification time resolves against
# this one zone (specs.md section 4).
APP_TIMEZONE=Europe/Madrid

# Shared bearer token (D5). Leave empty and the API is UNAUTHENTICATED — it will
# say so loudly at startup. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Port nginx is published on locally. Behind the tunnel this is not used.
WEB_PORT=8080

# --- Web Push (D1b) ---
# Generate a pair with:
#   docker compose exec api python scripts/generate_vapid_keys.py
# Without these, notifications are disabled and the scheduler does not start.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Cloudflare Tunnel ---
# From the Cloudflare Zero Trust dashboard. Start it with:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
